datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  GURU
  SISWA
}

model Jurusan {
  id_jurusan   Int     @id @default(autoincrement())
  kode_jurusan String  @unique @db.VarChar(20)
  nama_jurusan String  @db.VarChar(100)
  kelas        Kelas[]

  @@map("jurusan")
}

model Kelas {
  id_kelas   Int      @id @default(autoincrement())
  id_jurusan Int
  tingkat    String   @db.VarChar(10)
  nama_kelas String   @db.VarChar(50)
  jurusan    Jurusan  @relation(fields: [id_jurusan], references: [id_jurusan], onDelete: Restrict)
  siswa      Siswa[]
  jadwal     Jadwal[]

  @@map("kelas")
}

model Siswa {
  nis           String   @id @db.VarChar(20)
  id_kelas      Int
  nama_siswa    String   @db.VarChar(100)
  jenis_kelamin String   @db.VarChar(1) // 'L' or 'P'
  tanggal_lahir DateTime @db.Date
  alamat        String   @db.Text
  kelas         Kelas    @relation(fields: [id_kelas], references: [id_kelas], onDelete: Restrict)
  nilai         Nilai[]
  user          User?

  @@map("siswa")
}

model Guru {
  id_guru   Int      @id @default(autoincrement())
  nip       String   @unique @db.VarChar(30)
  nama_guru String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  no_hp     String   @db.VarChar(20)
  jadwal    Jadwal[]
  nilai     Nilai[]
  user      User?

  @@map("guru")
}

model MataPelajaran {
  id_mapel   Int      @id @default(autoincrement())
  kode_mapel String   @unique @db.VarChar(20)
  nama_mapel String   @db.VarChar(100)
  kelompok   String   @db.VarChar(50) // e.g. "Muatan Kejuruan", "Muatan Nasional", "Muatan Kewilayahan"
  jadwal     Jadwal[]
  nilai      Nilai[]

  @@map("mata_pelajaran")
}

model Jadwal {
  id_jadwal     Int           @id @default(autoincrement())
  id_guru       Int
  id_kelas      Int
  id_mapel      Int
  hari          String        @db.VarChar(20) // Senin, Selasa, Rabu, Kamis, Jumat, Sabtu
  jam_mulai     String        @db.VarChar(10) // "07:30"
  jam_selesai   String        @db.VarChar(10) // "09:00"
  ruang         String        @db.VarChar(50)
  guru          Guru          @relation(fields: [id_guru], references: [id_guru], onDelete: Restrict)
  kelas         Kelas         @relation(fields: [id_kelas], references: [id_kelas], onDelete: Restrict)
  mataPelajaran MataPelajaran @relation(fields: [id_mapel], references: [id_mapel], onDelete: Restrict)

  @@index([hari, jam_mulai, jam_selesai])
  @@map("jadwal")
}

model TahunAjaran {
  id_tahun_ajaran Int     @id @default(autoincrement())
  tahun_ajaran    String  @db.VarChar(20) // "2024/2025"
  semester        String  @db.VarChar(10) // "Ganjil", "Genap"
  status          String  @db.VarChar(20) // "Aktif", "Tidak Aktif"
  nilai           Nilai[]

  @@map("tahun_ajaran")
}

model Nilai {
  id_nilai        Int           @id @default(autoincrement())
  nis             String        @db.VarChar(20)
  id_tahun_ajaran Int
  id_guru         Int
  id_mapel        Int
  nilai_tugas     Float         @default(0)
  nilai_uts       Float         @default(0)
  nilai_uas       Float         @default(0)
  nilai_akhir     Float         @default(0)
  siswa           Siswa         @relation(fields: [nis], references: [nis], onDelete: Cascade)
  tahunAjaran     TahunAjaran   @relation(fields: [id_tahun_ajaran], references: [id_tahun_ajaran], onDelete: Restrict)
  guru            Guru          @relation(fields: [id_guru], references: [id_guru], onDelete: Restrict)
  mataPelajaran   MataPelajaran @relation(fields: [id_mapel], references: [id_mapel], onDelete: Restrict)

  @@unique([nis, id_mapel, id_tahun_ajaran])
  @@map("nilai")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      Role     @default(SISWA)
  id_guru   Int?     @unique
  nis       String?  @unique @db.VarChar(20)
  nama      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guru      Guru?    @relation(fields: [id_guru], references: [id_guru], onDelete: SetNull)
  siswa     Siswa?   @relation(fields: [nis], references: [nis], onDelete: SetNull)

  @@map("users")
}
